# Environment Configuration Template — MAGICA Platform

# -----------------------------------------------------------------------------
# Application Environment
# -----------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MAGICA"
NEXT_PUBLIC_APP_TAGLINE="Stay. Eat. Celebrate. Feel the Magic."
NEXT_PUBLIC_BUSINESS_LOCATION="Kasol, Parvati Valley, Himachal Pradesh, India"

# -----------------------------------------------------------------------------
# API Client Configuration (Portable REST Backend)
# -----------------------------------------------------------------------------
# When NEXT_PUBLIC_USE_MOCK_API is 'true', the client services use deterministic
# in-memory mock repositories for prototyping, testing, and offline development.
NEXT_PUBLIC_USE_MOCK_API=true
NEXT_PUBLIC_API_BASE_URL=https://api.magica.in/v1

# -----------------------------------------------------------------------------
# Future Backend & Database (PHP 8.3+ / Laravel on MilesWeb)
# (Kept in backend .env, never exposed to client)
# -----------------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=magica_production
# DB_USERNAME=magica_user
# DB_PASSWORD=your_secure_password

# -----------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# -----------------------------------------------------------------------------
# Public Key can be used on the client for Razorpay Standard Checkout modal
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Secret & Webhook Secret must strictly live on the PHP backend
# RAZORPAY_KEY_SECRET=placeholder_secret_key
# RAZORPAY_WEBHOOK_SECRET=placeholder_webhook_secret

# -----------------------------------------------------------------------------
# Business Timezone & Currency
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Kolkata
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=₹
